<?xml version="1.0"?>
<robot>
  <gazebo>
    <plugin
    filename="gz-sim-joint-state-publisher-system"
    name="gz::sim::systems::JointStatePublisher">
    
    <topic>joint_states</topic> 
    
    <joint_name>FR_H_F</joint_name>
    <joint_name>FR_H_S</joint_name>
    <joint_name>FR_T_K</joint_name>
    <joint_name>FR_T_A</joint_name>
    
    <joint_name>FL_H_F</joint_name>
    <joint_name>FL_H_S</joint_name>
    <joint_name>FL_T_K</joint_name>
    <joint_name>FL_T_A</joint_name>
    
    <joint_name>RR_H_F</joint_name>
    <joint_name>RR_H_S</joint_name>
    <joint_name>RR_T_K</joint_name>
    <joint_name>RR_T_A</joint_name>
    
    <joint_name>RL_H_F</joint_name>
    <joint_name>RL_H_S</joint_name>
    <joint_name>RL_T_K</joint_name>
    <joint_name>RL_T_A</joint_name>

  </plugin>
  
  </gazebo>

  <gazebo>
    <plugin filename="libgz_ros2_control-system.so" name="gz_ros2_control::GazeboSimROS2ControlPlugin">

    <parameters>$(find husky_description)/config/controller.yaml</parameters>

    <!-- Optional: specify controller manager node name -->
    <controller_manager_prefix_node_name>controller_manager</controller_manager_prefix_node_name>

    <!-- Optional: tuning -->
    <hold_joints>true</hold_joints>
    <position_proportional_gain>0.5</position_proportional_gain>

  </plugin>
</gazebo>


</robot>