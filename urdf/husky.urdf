<xacro:property name="blade_x_disp_front" value="0.141" />
<xacro:property name="blade_x_disp_back" value="0.125" />
<xacro:property name="blade_y_disp" value="0.189" />
<xacro:property name="blade_z_disp" value="0.1" />
<xacro:property name="blade_damping" value="0.0" />
<xacro:property name="blade_sfriction" value="0" />

<!--arducopter blades-->
  <link
    name="front_right_blade">
    <inertial>
      <origin
        xyz="0 0 0.004"
        rpy="0 0 0" />
      <mass
        value="0.0061" />
      <inertia ixx="9.75e-08" ixy="0" ixz="0" iyy="1.67e-06" iyz="0" izz="1.67e-06"/>
    </inertial>
  </link>
  <link
    name="front_left_blade">
    <inertial>
      <origin
        xyz="0 0 0.004"
        rpy="0 0 0" />
      <mass
        value="0.0061" />
      <inertia ixx="9.75e-08" ixy="0" ixz="0" iyy="1.67e-06" iyz="0" izz="1.67e-06"/>
    </inertial>
  </link>
  <link
    name="rear_left_blade">
    <inertial>
      <origin
        xyz="0 0 0.004"
        rpy="0 0 0" />
      <mass
        value="0.0061" />
      <inertia ixx="9.75e-08" ixy="0" ixz="0" iyy="1.67e-06" iyz="0" izz="1.67e-06"/>
    </inertial>
  </link>
  <link
    name="rear_right_blade">
    <inertial>
      <origin
        xyz="0 0 0.004"
        rpy="0 0 0" />
      <mass
        value="0.0061" />
      <inertia ixx="9.75e-08" ixy="0" ixz="0" iyy="1.67e-06" iyz="0" izz="1.67e-06"/>
    </inertial>
  </link>

  <joint
    name="front_right_blade_joint"
    type="revolute">
    <origin
      xyz="${blade_x_disp_front} ${-blade_y_disp} ${blade_z_disp}"
      rpy="0 0 0" />
    <parent
      link="base" />
    <child
      link="front_right_blade" />
    <axis
      xyz="0 0 1" />
    <dynamics damping="${blade_damping}" friction="${blade_sfriction}"/>
    <limit lower="-1e+16" upper="1e+16" effort="10000" velocity="10000"/>
  </joint>

  <joint
    name="front_left_blade_joint"
    type="revolute">
    <origin
      xyz="${blade_x_disp_front} ${blade_y_disp} ${blade_z_disp}"
      rpy="0 0 0" />
    <parent
      link="base" />
    <child
      link="front_left_blade" />
    <axis
      xyz="0 0 1" />
    <dynamics damping="${blade_damping}" friction="${blade_sfriction}"/>
    <limit lower="-1e+16" upper="1e+16" effort="10000" velocity="10000"/>
  </joint>

  <joint   name="rear_left_blade_joint"
    type="revolute">
    <origin
      xyz="${-blade_x_disp_back} ${blade_y_disp} ${blade_z_disp}"
      rpy="0 0 0" />
    <parent
      link="base" />
    <child
      link="rear_left_blade" />
    <axis
      xyz="0 0 1" />
    <dynamics damping="${blade_damping}" friction="${blade_sfriction}"/>
    <limit lower="-1e+16" upper="1e+16" effort="10000" velocity="10000"/>
  </joint>

  <joint
    name="rear_right_blade_joint"
    type="revolute">
    <origin
      xyz="${-blade_x_disp_back} ${-blade_y_disp} ${blade_z_disp}"
      rpy="0 0 0" />
    <parent
      link="base" />
    <child
      link="rear_right_blade" />
    <axis
      xyz="0 0 1" />
    <dynamics damping="${blade_damping}" friction="${blade_sfriction}"/>
    <limit lower="-1e+16" upper="1e+16" effort="10000" velocity="10000"/>  
  </joint>

</robot>