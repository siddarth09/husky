      <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
      <geometry>
        <mesh filename="package://husky_model_description/meshes/fr_fibula.STL" scale="1 1 1"/>
      </geometry>
      <material name="">
        <color rgba="0.298 0.298 0.298 1.0"/>
      </material>
    </visual>
  </link>

  <link name="bl_fibula">
    <inertial>
      <mass value="0.020"/> 
      <origin rpy="0.0 0.0 0.0" xyz="0.173 -0.0 -0.000"/>
      <inertia ixx="8.92564e-07" ixy="-6.08931e-13" ixz="-4.52477e-07" iyy="0.000405016" iyz="-1.2126e-09" izz="0.000405428"/>
    </inertial>
    <collision>
      <origin rpy="0.0 1.5708 0.0" xyz="${fibula_ix} 0 0"/>
      <geometry>
        <cylinder length="${fibula_length}" radius="${fibula_radius}"/>
      </geometry>
    </collision>
    <visual name="bl_fibula_visual">
      <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
      <geometry>
        <mesh filename="package://husky_model_description/meshes/fr_fibula.STL" scale="1 1 1"/>
      </geometry>
      <material name="">
        <color rgba="0.298 0.298 0.298 1.0"/>
      </material>
    </visual>
  </link>

  <link name="br_fibula">
    <inertial>
      <mass value="0.020"/> 
      <origin rpy="0.0 0.0 0.0" xyz="0.173 -0.0 -0.000"/>
      <inertia ixx="8.92564e-07" ixy="-6.08931e-13" ixz="-4.52477e-07" iyy="0.000405016" iyz="-1.2126e-09" izz="0.000405428"/>
    </inertial>
    <collision>
      <origin rpy="0.0 1.5708 0.0" xyz="${fibula_ix} 0 0"/>
      <geometry>
        <cylinder length="${fibula_length}" radius="${fibula_radius}"/>
      </geometry>
    </collision>
    <visual name="br_fibula_visual">
      <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
      <geometry>
        <mesh filename="package://husky_model_description/meshes/fr_fibula.STL" scale="1 1 1"/>
      </geometry>
      <material name="">
