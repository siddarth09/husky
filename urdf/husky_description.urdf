    </actuator>
  </transmission>
  <!-- Rear Right Leg -->
  <transmission name="RH_HAA_trans">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="RH_HAA">
      <hardwareInterface>position</hardwareInterface>
    </joint>
    <actuator name="RH_HAA_motor">
      <hardwareInterface>position</hardwareInterface>
      <mechanicalReduction>1</mechanicalReduction>
    </actuator>
  </transmission>
  <transmission name="RH_HFE_trans">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="RH_HFE">
      <hardwareInterface>position</hardwareInterface>
    </joint>
    <actuator name="RH_HFE_motor">
      <hardwareInterface>position</hardwareInterface>
      <mechanicalReduction>1</mechanicalReduction>
    </actuator>
  </transmission>
  <transmission name="RH_KFE_trans">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="RH_KFE">
      <hardwareInterface>position</hardwareInterface>
    </joint>
    <actuator name="RH_KFE_motor">
      <hardwareInterface>position</hardwareInterface>
      <mechanicalReduction>1</mechanicalReduction>
    </actuator>
  </transmission>
  <!-- Rear Left Leg -->
  <transmission name="LH_HAA_trans">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="LH_HAA">
      <hardwareInterface>position</hardwareInterface>
    </joint>
    <actuator name="LH_HAA_motor">
      <hardwareInterface>position</hardwareInterface>
      <mechanicalReduction>1</mechanicalReduction>
    </actuator>
  </transmission>
  <transmission name="LH_HFE_trans">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="LH_HFE">
      <hardwareInterface>position</hardwareInterface>
    </joint>
    <actuator name="LH_HFE_motor">
      <hardwareInterface>position</hardwareInterface>
      <mechanicalReduction>1</mechanicalReduction>
    </actuator>
  </transmission>
  <transmission name="LH_KFE_trans">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="LH_KFE">
      <hardwareInterface>position</hardwareInterface>
    </joint>
    <actuator name="LH_KFE_motor">
      <hardwareInterface>position</hardwareInterface>
      <mechanicalReduction>1</mechanicalReduction>
    </actuator>
  </transmission>
  <ros2_control name="GazeboSystem" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
      <param name="command_interface">position</param>
    </hardware>
    <!-- 12 Actuated Joints -->
    <joint name="RF_HAA">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="RF_HFE">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="RF_KFE">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="LF_HAA">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="LF_HFE">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="LF_KFE">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="RH_HAA">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="RH_HFE">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="RH_KFE">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="LH_HAA">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="LH_HFE">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="LH_KFE">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <!-- Mimic joints (only state interfaces) -->
    <joint name="LF_ankle">
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="LH_ankle">
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="RH_ankle">
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="fr_control_rod">
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="fl_control_rod">
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="br_control_rod">
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="bl_control_rod">
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>
  <joint name="camera_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0.225 0 0.075"/>
    <child link="camera_link"/>
    <parent link="base"/>
    <axis xyz="0 1 0"/>
  </joint>
  <link name="camera_link">
    <pose>0 0 0 0 0 0</pose>
    <inertial>
      <mass value="0.1"/>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/>
    </inertial>
    <collision name="collision">
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <box size=".03 .03 .03"/>
      </geometry>
    </collision>
    <visual name="camera_link_visual">
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <box size=".03 .03 .03"/>
      </geometry>
    </visual>
  </link>
  <gazebo reference="camera_link">
    <material>Gazebo/Red</material>
  </gazebo>
  <joint name="camera_optical_joint" type="fixed">
    <origin rpy="-1.5707 0 -1.5707" xyz="0 0 0"/>
    <child link="camera_link_optical"/>
    <parent link="camera_link"/>
  </joint>
  <link name="camera_link_optical">
  </link>
  <!-- STEP 8 - IMU -->
  <joint name="imu_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0 0 0"/>
    <parent link="base"/>
    <child link="imu_link"/>
  </joint>
  <link name="imu_link">
  </link>
  <gazebo reference="camera_link">
    <sensor name="depth_camera" type="depth_camera">
      <camera>
        <horizontal_fov>1.25</horizontal_fov>
        <image>
          <width>320</width>
          <height>240</height>
          <!-- <format>L16</format> -->
        </image>
        <clip>
          <near>0.1</near>
          <far>20</far>
        </clip>
        <!-- <optical_frame_id>camera_link</optical_frame_id> -->
        <optical_frame_id>camera_link_optical</optical_frame_id>
        <!-- <camera_info_topic>camera_info</camera_info_topic> -->
      </camera>
      <always_on>1</always_on>
      <update_rate>20</update_rate>
      <visualize>true</visualize>
      <topic>camera_depth</topic>
      <gz_frame_id>camera_link</gz_frame_id>
    </sensor>
    <sensor name="camera" type="camera">
      <camera>
        <horizontal_fov>1.25</horizontal_fov>
        <image>
          <width>320</width>
          <height>240</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.1</near>
          <far>20</far>
        </clip>
        <optical_frame_id>camera_link_optical</optical_frame_id>
        <camera_info_topic>camera_info</camera_info_topic>
      </camera>
      <always_on>1</always_on>
      <update_rate>20</update_rate>
      <visualize>true</visualize>
      <topic>camera</topic>
    </sensor>
  </gazebo>
  <gazebo reference="imu_link">
    <sensor name="imu" type="imu">
      <always_on>1</always_on>
      <update_rate>50</update_rate>
      <visualize>true</visualize>
      <topic>imu</topic>
      <enable_metrics>true</enable_metrics>
      <gz_frame_id>imu_link</gz_frame_id>
    </sensor>
  </gazebo>
</robot>
