    <gazebo>
        <plugin
            filename="gz-sim-joint-state-publisher-system"
            name="gz::sim::systems::JointStatePublisher">
            <topic>joint_states</topic> <!--from <ros><remapping> -->
            <joint_name>hussain_imu_joint</joint_name>
            <joint_name>RF_HAA</joint_name>
            <joint_name>LF_HAA</joint_name>
            <joint_name>LH_HAA</joint_name>
            <joint_name>RH_HAA</joint_name>
            <joint_name>RF_HFE</joint_name>
            <joint_name>LF_HFE</joint_name>
            <joint_name>LH_HFE</joint_name>
            <joint_name>RH_HFE</joint_name>
            <joint_name>RF_KFE</joint_name>
            <joint_name>LF_KFE</joint_name>
            <joint_name>LH_KFE</joint_name>
            <joint_name>RH_KFE</joint_name>
            <joint_name>RF_ankle</joint_name>
            <joint_name>LF_ankle</joint_name>
            <joint_name>RH_ankle</joint_name>
            <joint_name>RF_foot_fixed</joint_name>
            <joint_name>LF_foot_fixed</joint_name>
            <joint_name>LH_foot_fixed</joint_name>
            <joint_name>RH_foot_fixed</joint_name>
            <joint_name>root_to_base_joint</joint_name>
            <joint_name>fr_control_rod</joint_name>
            <joint_name>fl_control_rod</joint_name>
            <joint_name>bl_control_rod</joint_name>
            <joint_name>br_control_rod</joint_name>
            <joint_name>front_right_blade_joint</joint_name>
            <joint_name>front_left_blade_joint</joint_name>
            <joint_name>rear_left_blade_joint</joint_name>
            <joint_name>rear_right_blade_joint</joint_name>
            <joint_name>camera_joint</joint_name>
            <joint_name>camera_optical_joint</joint_name>
        </plugin>
    </gazebo>
    <gazebo>
        <plugin filename="gz-sim-lift-drag-system"
            name="gz::sim::systems::LiftDrag">
        <a0>0.3</a0>
        <alpha_stall>1.4</alpha_stall>
        <cla>4.2500</cla>
        <cda>1.2041</cda>
        <cma>0.0</cma>
        <cla_stall>-0.025</cla_stall>
        <cda_stall>0.0</cda_stall>
        <cma_stall>0.0</cma_stall>
        <area>0.002</area>
        <air_density>1.2041</air_density>
        <cp>0.084 0 0</cp>
        <forward>0 1 0</forward>
        <upward>0 0 1</upward>
        <link_name>front_right_blade</link_name>
        </plugin>
    </gazebo>
    <gazebo>
        <plugin filename="gz-sim-lift-drag-system"
            name="gz::sim::systems::LiftDrag">
        <a0>0.3</a0>
        <alpha_stall>1.4</alpha_stall>
